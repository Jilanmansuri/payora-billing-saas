# MongoDB Database URI (Use MongoDB Atlas connection string in production)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/billora?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/billora?retryWrites=true&w=majority

# Base Application URL
NEXT_PUBLIC_APP_URL=https://your-billora-domain.vercel.app

# App Environment
NODE_ENV=production

